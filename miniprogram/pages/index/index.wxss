.page-container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 160rpx;
}

/* Header Banner */
.header-banner {
  background: linear-gradient(180deg, #1E1E28 0%, #1A1A1F 100%);
  padding: 60rpx 30rpx 50rpx;
  border-radius: 0 0 36rpx 36rpx;
  border-bottom: 1rpx solid var(--border-subtle);
  position: relative;
  overflow: hidden;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.greeting {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 6rpx;
}

.month-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.stats-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(124, 110, 255, 0.12);
  border-radius: 50%;
  border: 1rpx solid rgba(124, 110, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-icon {
  font-size: 36rpx;
}

/* Hero Balance — ambient glow via radial gradient background */
.hero-balance {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 10rpx;
  background: radial-gradient(ellipse 320rpx 140rpx at 50% 40%, rgba(124, 110, 255, 0.1) 0%, transparent 70%);
  border-radius: 20rpx;
}

.hero-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.hero-amount {
  color: var(--text-primary);
  margin-bottom: 28rpx;
  /* Subtle luminous glow on the balance number */
  text-shadow: 0 0 40rpx rgba(124, 110, 255, 0.28), 0 2rpx 0 rgba(255,255,255,0.04);
}

.hero-sub-row {
  display: flex;
  flex-direction: row;
  gap: 0;
  width: 100%;
  justify-content: center;
}

.hero-sub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.hero-sub-item:first-child::after {
  display: none;
}

.hero-sub-item + .hero-sub-item {
  border-left: 1rpx solid var(--border-subtle);
}

.hero-sub-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.hero-sub-amount {
  font-size: 30rpx;
  font-weight: 700;
  font-family: 'Courier New', Courier, monospace;
}

/* Neon glow on sub-amounts */
.hero-sub-amount.income-text {
  text-shadow: 0 0 16rpx var(--glow-income);
}
.hero-sub-amount.expense-text {
  text-shadow: 0 0 14rpx var(--glow-expense);
}

/* Quick Actions */
.quick-actions {
  display: flex;
  flex-direction: row;
  background: linear-gradient(145deg, #1E1E26 0%, #1A1A1F 100%);
  margin: 24rpx 30rpx 0;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  border: 1rpx solid var(--border-subtle);
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon-wrap {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border: 1rpx solid transparent;
}

.expense-wrap {
  background: rgba(255, 71, 87, 0.12);
  border-color: rgba(255, 71, 87, 0.2);
}
.income-wrap {
  background: rgba(0, 255, 135, 0.1);
  border-color: rgba(0, 255, 135, 0.18);
}
.stats-wrap {
  background: rgba(124, 110, 255, 0.12);
  border-color: rgba(124, 110, 255, 0.2);
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* Section */
.section {
  margin: 24rpx 30rpx 0;
  background: linear-gradient(145deg, #1E1E26 0%, #1A1A1F 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid var(--border-subtle);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-accent);
  opacity: 0.8;
}

/* Loading */
.loading-state {
  text-align: center;
  padding: 40rpx;
}

/* Bills List */
.bills-list {
  display: flex;
  flex-direction: column;
}

/* Bill item — base */
.bill-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  padding-left: 16rpx;
  border-bottom: 1rpx solid var(--border-divider);
  border-left: 3rpx solid transparent;
  margin-left: -16rpx;
  transition: border-left-color 0.2s;
}

.bill-item:last-child {
  border-bottom: none;
}

/* Chromatic left stripe by type */
.bill-item-income {
  border-left-color: rgba(0, 255, 135, 0.45);
}
.bill-item-expense {
  border-left-color: rgba(255, 71, 87, 0.4);
}

.bill-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  background: var(--bg-card-2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bill-item-income .bill-icon-wrap {
  border: 1rpx solid rgba(0, 255, 135, 0.15);
}
.bill-item-expense .bill-icon-wrap {
  border: 1rpx solid rgba(255, 71, 87, 0.12);
}

.bill-icon {
  font-size: 34rpx;
}

.bill-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bill-category {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 5rpx;
}

.bill-note {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.bill-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.bill-amount {
  font-size: 30rpx;
  font-weight: 700;
  font-family: 'Courier New', Courier, monospace;
  margin-bottom: 5rpx;
}

/* Neon glow on amounts */
.income-text {
  color: var(--color-income);
  text-shadow: 0 0 12rpx rgba(0, 255, 135, 0.4);
}
.expense-text {
  color: var(--color-expense);
  text-shadow: 0 0 10rpx rgba(255, 71, 87, 0.35);
}

.bill-date {
  font-size: 20rpx;
  color: var(--text-secondary);
  opacity: 0.7;
}

/* Empty State */
.empty-bills {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

/* FAB Button — breathes */
.fab-btn {
  position: fixed;
  bottom: 160rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #8B7FFF 0%, #6B5EFF 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fabGlow 3s ease-in-out infinite;
  z-index: 100;
  border: 1rpx solid rgba(255,255,255,0.08);
}

.fab-icon {
  font-size: 54rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}
