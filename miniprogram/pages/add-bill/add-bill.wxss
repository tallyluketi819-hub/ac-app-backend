.page-container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* Type Toggle */
.type-toggle {
  display: flex;
  flex-direction: row;
  background: linear-gradient(145deg, #1E1E26 0%, #1A1A1F 100%);
  padding: 16rpx 30rpx;
  border-bottom: 1rpx solid var(--border-subtle);
}

.type-btn {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  margin: 0 8rpx;
  background: var(--bg-card-2);
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.type-icon {
  font-size: 30rpx;
  margin-right: 8rpx;
}

.type-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.type-active .type-text {
  color: #ffffff;
  font-weight: 700;
}

/* Active states with glow */
.expense-active {
  background: var(--color-expense);
  border-color: rgba(255, 71, 87, 0.5);
  box-shadow: 0 2rpx 20rpx rgba(255, 71, 87, 0.45);
}

.income-active {
  background: var(--color-income);
  border-color: rgba(0, 255, 135, 0.5);
  box-shadow: 0 2rpx 20rpx rgba(0, 255, 135, 0.4);
}
.income-active .type-text { color: #0D0D0F; }

/* Amount Section — changes hue by type */
.amount-section {
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(145deg, #1E1E26 0%, #1A1A1F 100%);
  margin: 20rpx 30rpx 0;
  border-radius: 20rpx;
  border: 1rpx solid var(--border-subtle);
  position: relative;
  overflow: hidden;
}

/* Radial ambient glow inside amount section */
.expense-bg {
  border-color: rgba(255, 71, 87, 0.22);
  background: linear-gradient(180deg, rgba(255, 71, 87, 0.06) 0%, #1A1A1F 55%);
}

.income-bg {
  border-color: rgba(0, 255, 135, 0.2);
  background: linear-gradient(180deg, rgba(0, 255, 135, 0.05) 0%, #1A1A1F 55%);
}

.amount-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.amount-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* Currency symbol shifts color based on type */
.currency-symbol {
  font-size: 48rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
  font-weight: 300;
  font-family: 'Courier New', Courier, monospace;
}

.expense-bg .currency-symbol {
  color: var(--color-expense);
  opacity: 0.6;
}
.income-bg .currency-symbol {
  color: var(--color-income);
  opacity: 0.6;
}

/* Amount input — neon color by type */
.amount-input {
  font-size: 80rpx;
  color: var(--text-primary);
  font-weight: 700;
  font-family: 'Courier New', Courier, monospace;
  min-width: 200rpx;
  max-width: 460rpx;
  text-align: center;
  height: 100rpx;
}

.expense-bg .amount-input {
  color: var(--color-expense);
  text-shadow: 0 0 32rpx rgba(255, 71, 87, 0.35);
}
.income-bg .amount-input {
  color: var(--color-income);
  text-shadow: 0 0 32rpx rgba(0, 255, 135, 0.3);
}

.amount-placeholder {
  color: var(--text-placeholder);
  font-size: 80rpx;
}

/* Section Cards */
.section-card {
  margin: 20rpx 30rpx 0;
  background: linear-gradient(145deg, #1E1E26 0%, #1A1A1F 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid var(--border-subtle);
}

.section-heading {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 2rpx;
}

/* Category Grid */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.category-item {
  width: calc(25% - 16rpx);
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  border-radius: 16rpx;
  background: var(--bg-card-2);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

/* Selected category — glow ring */
.category-selected {
  background: rgba(124, 110, 255, 0.2);
  border-color: var(--color-accent);
  box-shadow: 0 0 0 2rpx rgba(124, 110, 255, 0.25), 0 4rpx 20rpx rgba(124, 110, 255, 0.35);
}

.cat-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.category-selected .cat-name {
  color: #FFFFFF;
  font-weight: 600;
  text-shadow: 0 0 10rpx rgba(124, 110, 255, 0.6);
}

/* Form Rows */
.form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 80rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  width: 130rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  height: 72rpx;
  padding: 0 10rpx;
  background: transparent;
}

.input-placeholder {
  color: var(--text-placeholder);
  font-size: 28rpx;
}

.divider-thin {
  height: 1rpx;
  background: var(--border-divider);
  margin: 4rpx 0;
}

.date-picker-val {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
  height: 72rpx;
}

.date-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.date-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* Save Button */
.save-section {
  padding: 40rpx 30rpx;
}
